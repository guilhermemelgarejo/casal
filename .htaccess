<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Permitir o script de deploy direto
    RewriteRule ^deploy_extractor\.php$ - [L]

    # Bloquear acesso direto a arquivos confidenciais
    <FilesMatch "^\.(env|git|editorconfig|ftp)|composer\.(json|lock)|package\.json|phpunit\.xml|README\.md|artisan|\.zip$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Bloquear acesso direto às pastas privadas do Laravel
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests)(/.*)?$ - [F,L]

    # Redirecionar todas as outras requisições para a pasta public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
