APP_NAME="DuoZen"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://casal.localhost

# Login Google: aplicar manualmente o SQL revisado antes de ativar. Não usa as credenciais do Drive.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=
DEPLOY_TOKEN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe (Laravel Cashier) — assinatura mensal com período de teste
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Price ID mensal criado no Stripe Dashboard (Products → Prices)
STRIPE_PRICE_ID=

# Moeda e locale de faturamento (ex.: brl, pt_BR)
CASHIER_CURRENCY=brl
CASHIER_CURRENCY_LOCALE=pt_BR

# Legado: não é mais usado para conceder administração
DUOZEN_SUBSCRIPTION_ADMIN_COUPLE_ID=

# IDs explícitos dos administradores existentes (e-mail verificado obrigatório)
DUOZEN_ADMIN_USER_IDS=

# E-mails com acesso à área /admin/assinaturas (separados por vírgula)
DUOZEN_ADMIN_EMAILS=

# Isentos de plano (além dos admins), separados por vírgula
DUOZEN_BILLING_EXEMPT_EMAILS=

# Dias de teste após registrar cartão no Checkout (mínimo ~3 por requisitos do Stripe)
DUOZEN_TRIAL_DAYS=14

# true = não exige assinatura (útil em dev/testes)
DUOZEN_BILLING_DISABLED=false

# Identificação do fornecedor nos Termos (Decreto 7.962/2013)
# Nome empresarial ou nome completo, CNPJ ou CPF, endereço e e-mail de atendimento
DUOZEN_LEGAL_NAME=
DUOZEN_LEGAL_DOCUMENT=
DUOZEN_LEGAL_ADDRESS=
DUOZEN_LEGAL_EMAIL=

# Landing e redes sociais (opcionais; só aparecem quando preenchidos)
# Preço mensal exibido ao público, igual ao preço do Stripe (ex.: 19.90)
DUOZEN_PUBLIC_PRICE_AMOUNT=
# Perfil exibido no rodapé (padrão: @duozen.app)
DUOZEN_SOCIAL_HANDLE=@duozen.app
# URLs completas com https:// (Instagram padrão: https://www.instagram.com/duozen.app/)
DUOZEN_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/duozen.app/
DUOZEN_SOCIAL_TIKTOK_URL=
DUOZEN_SOCIAL_YOUTUBE_URL=
DUOZEN_SOCIAL_FACEBOOK_URL=

# ==============================================================================
# Rotina de Backup Automático (Google Drive + Criptografia AES-256 + E-mail)
# ==============================================================================
# Senha forte para abrir o arquivo .zip gerado (Guarde esta senha para restaurar)
BACKUP_ZIP_PASSWORD=

# Prazo de guarda dos backups no Google Drive, em dias (ex.: 90). Os mais antigos são apagados
# definitivamente após cada backup, mantendo sempre os 7 mais recentes. O prazo aparece na
# Política de Privacidade. Vazio ou 0 desativa a limpeza.
BACKUP_RETENTION_DAYS=

# Google Drive OAuth 2.0 (Para contas pessoais @gmail.com - gerar com: php artisan drive:auth)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# ID da pasta do Google Drive (extraído da URL da pasta no Drive pessoal)
GOOGLE_DRIVE_FOLDER_ID=

# E-mail que receberá a notificação com o link do Google Drive
BACKUP_NOTIFICATION_EMAIL=

# Opcional / Legado: Arquivo JSON de Conta de Serviço (apenas Google Workspace / Shared Drives)
# GOOGLE_DRIVE_CREDENTIALS_PATH="storage/app/google-credentials.json"



